# Copy to .env.production.local and use YOUR Firebase web app configuration.
# These web config values are public identifiers, not Admin SDK credentials.
REACT_APP_USE_FIREBASE_EMULATORS=false
REACT_APP_FIREBASE_API_KEY=replace-with-web-api-key
REACT_APP_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=your-project-id
REACT_APP_FIREBASE_APP_ID=replace-with-web-app-id
# Optional for the quiz/CMS; required by the separate legacy audio workflow.
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_MEASUREMENT_ID=
